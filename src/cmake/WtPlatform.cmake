function(WT_NORMALIZE_ARCH WT_ARCH WT_OUTPUT)
	string(STRIP "${WT_ARCH}" WT_ARCH_VALUE)
	string(TOLOWER "${WT_ARCH_VALUE}" WT_ARCH_VALUE)

	if(WT_ARCH_VALUE STREQUAL "arm64" OR WT_ARCH_VALUE STREQUAL "aarch64")
		set(${WT_OUTPUT} arm64 PARENT_SCOPE)
	elseif(WT_ARCH_VALUE STREQUAL "x86_64" OR WT_ARCH_VALUE STREQUAL "amd64" OR WT_ARCH_VALUE STREQUAL "x64")
		set(${WT_OUTPUT} x64 PARENT_SCOPE)
	elseif(WT_ARCH_VALUE STREQUAL "i386" OR WT_ARCH_VALUE STREQUAL "i686" OR WT_ARCH_VALUE STREQUAL "x86" OR WT_ARCH_VALUE STREQUAL "win32")
		set(${WT_OUTPUT} x86 PARENT_SCOPE)
	else()
		message(FATAL_ERROR "Unsupported architecture '${WT_ARCH}'")
	endif()
endfunction()

function(WT_CANONICALIZE_OSX_ARCH WT_ARCH WT_OUTPUT)
	WT_NORMALIZE_ARCH("${WT_ARCH}" WT_NORMALIZED_ARCH)
	if(WT_NORMALIZED_ARCH STREQUAL "arm64")
		set(${WT_OUTPUT} arm64 PARENT_SCOPE)
	elseif(WT_NORMALIZED_ARCH STREQUAL "x64")
		set(${WT_OUTPUT} x86_64 PARENT_SCOPE)
	else()
		message(FATAL_ERROR "Unsupported macOS architecture '${WT_ARCH}'. Supported single-architecture values are arm64/aarch64 and x86_64/amd64")
	endif()
endfunction()

function(WT_NORMALIZE_PLATFORM_ARCH WT_SYSTEM_NAME WT_SYSTEM_PROCESSOR WT_OSX_ARCHITECTURES WT_GENERATOR_PLATFORM WT_OUTPUT)
	if(WT_SYSTEM_NAME STREQUAL "Darwin")
		if(NOT "${WT_OSX_ARCHITECTURES}" STREQUAL "")
			set(WT_ARCH_LIST ${WT_OSX_ARCHITECTURES})
			list(LENGTH WT_ARCH_LIST WT_ARCH_COUNT)
			if(NOT WT_ARCH_COUNT EQUAL 1)
				message(FATAL_ERROR "Multiple CMAKE_OSX_ARCHITECTURES values require universal dependencies; configure one architecture at a time for now")
			endif()
			list(GET WT_ARCH_LIST 0 WT_ARCH_VALUE)
		else()
			set(WT_ARCH_VALUE "${WT_SYSTEM_PROCESSOR}")
		endif()
	elseif(WT_SYSTEM_NAME STREQUAL "Windows" AND NOT "${WT_GENERATOR_PLATFORM}" STREQUAL "")
		set(WT_ARCH_VALUE "${WT_GENERATOR_PLATFORM}")
	else()
		set(WT_ARCH_VALUE "${WT_SYSTEM_PROCESSOR}")
	endif()

	if("${WT_ARCH_VALUE}" STREQUAL "")
		message(FATAL_ERROR "Unable to determine target architecture for system '${WT_SYSTEM_NAME}'. Set the target processor in the toolchain file")
	endif()

	WT_NORMALIZE_ARCH("${WT_ARCH_VALUE}" WT_NORMALIZED_ARCH)
	if(WT_SYSTEM_NAME STREQUAL "Darwin" AND WT_NORMALIZED_ARCH STREQUAL "x86")
		message(FATAL_ERROR "32-bit macOS builds are not supported")
	endif()

	set(${WT_OUTPUT} ${WT_NORMALIZED_ARCH} PARENT_SCOPE)
endfunction()

function(WT_RESOLVE_PLATFORM_VARS WT_SYSTEM_NAME WT_ARCH_VALUE OUT_SYSTEM OUT_SHARED_SUFFIX OUT_RUNTIME_SUBDIR)
	WT_NORMALIZE_ARCH("${WT_ARCH_VALUE}" WT_NORMALIZED_ARCH)

	if(WT_SYSTEM_NAME STREQUAL "Windows")
		set(WT_SYSTEM_VALUE windows)
		set(WT_SUFFIX_VALUE .dll)
		set(WT_RUNTIME_ROOT win)
	elseif(WT_SYSTEM_NAME STREQUAL "Linux")
		set(WT_SYSTEM_VALUE linux)
		set(WT_SUFFIX_VALUE .so)
		set(WT_RUNTIME_ROOT linux)
	elseif(WT_SYSTEM_NAME STREQUAL "Darwin")
		set(WT_SYSTEM_VALUE macos)
		set(WT_SUFFIX_VALUE .dylib)
		set(WT_RUNTIME_ROOT darwin)
	else()
		message(FATAL_ERROR "Unsupported target system '${WT_SYSTEM_NAME}'")
	endif()

	set(${OUT_SYSTEM} ${WT_SYSTEM_VALUE} PARENT_SCOPE)
	set(${OUT_SHARED_SUFFIX} ${WT_SUFFIX_VALUE} PARENT_SCOPE)
	set(${OUT_RUNTIME_SUBDIR} "${WT_RUNTIME_ROOT}/${WT_NORMALIZED_ARCH}" PARENT_SCOPE)
endfunction()
