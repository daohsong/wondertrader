function(WT_SETUP_PLATFORM_DEPENDENCY)
	if(TARGET WT::Platform)
		message(FATAL_ERROR "WT_SETUP_PLATFORM_DEPENDENCY must be called at most once")
	endif()

	find_package(Threads REQUIRED)
	add_library(WT_PLATFORM INTERFACE)
	add_library(WT::Platform ALIAS WT_PLATFORM)
	target_link_libraries(WT_PLATFORM INTERFACE Threads::Threads)
	if(CMAKE_DL_LIBS)
		target_link_libraries(WT_PLATFORM INTERFACE ${CMAKE_DL_LIBS})
	endif()
endfunction()

function(WT_CHECK_VENDOR_BINARY_ARCH WT_BINARY WT_OUTPUT_OK WT_OUTPUT_REASON)
	set(WT_BINARY_OK FALSE)
	set(WT_BINARY_REASON "")
	if(NOT EXISTS "${WT_BINARY}")
		set(WT_BINARY_REASON "file does not exist")
	else()
		find_program(WT_FILE_INSPECTOR NAMES file)
		if(WT_FILE_INSPECTOR)
			execute_process(
				COMMAND "${WT_FILE_INSPECTOR}" -b "${WT_BINARY}"
				RESULT_VARIABLE WT_FILE_RESULT
				OUTPUT_VARIABLE WT_FILE_OUTPUT
				ERROR_VARIABLE WT_FILE_ERROR
				OUTPUT_STRIP_TRAILING_WHITESPACE
				ERROR_STRIP_TRAILING_WHITESPACE
			)
			if(WT_FILE_RESULT EQUAL 0)
				set(WT_BINARY_INSPECTOR_KIND file)
			endif()
		endif()
		if((NOT WT_FILE_INSPECTOR OR NOT WT_FILE_RESULT EQUAL 0) AND CMAKE_OBJDUMP)
			execute_process(
				COMMAND "${CMAKE_OBJDUMP}" -f "${WT_BINARY}"
				RESULT_VARIABLE WT_FILE_RESULT
				OUTPUT_VARIABLE WT_FILE_OUTPUT
				ERROR_VARIABLE WT_FILE_ERROR
				OUTPUT_STRIP_TRAILING_WHITESPACE
				ERROR_STRIP_TRAILING_WHITESPACE
			)
			if(WT_FILE_RESULT EQUAL 0)
				set(WT_BINARY_INSPECTOR_KIND objdump)
			endif()
		endif()
		if(WIN32 AND (NOT DEFINED WT_FILE_RESULT OR NOT WT_FILE_RESULT EQUAL 0))
			get_filename_component(WT_COMPILER_DIRECTORY "${CMAKE_CXX_COMPILER}" DIRECTORY)
			find_program(WT_DUMPBIN_INSPECTOR NAMES dumpbin
				HINTS "${WT_COMPILER_DIRECTORY}"
			)
			if(WT_DUMPBIN_INSPECTOR)
				execute_process(
					COMMAND "${WT_DUMPBIN_INSPECTOR}" /HEADERS "${WT_BINARY}"
					RESULT_VARIABLE WT_FILE_RESULT
					OUTPUT_VARIABLE WT_FILE_OUTPUT
					ERROR_VARIABLE WT_FILE_ERROR
					OUTPUT_STRIP_TRAILING_WHITESPACE
					ERROR_STRIP_TRAILING_WHITESPACE
				)
				if(WT_FILE_RESULT EQUAL 0)
					set(WT_BINARY_INSPECTOR_KIND dumpbin)
				endif()
			endif()
		endif()
		if(NOT DEFINED WT_FILE_RESULT OR NOT WT_FILE_RESULT EQUAL 0)
			set(WT_BINARY_REASON "no usable file/objdump/dumpbin binary inspector")
		else()
			string(TOLOWER "${WT_FILE_OUTPUT}" WT_FILE_OUTPUT_LOWER)
			if(WT_BINARY_INSPECTOR_KIND STREQUAL "dumpbin" AND WT_ARCH STREQUAL "x64")
				set(WT_ARCH_PATTERN "8664 machine|machine \\(x64\\)")
			elseif(WT_BINARY_INSPECTOR_KIND STREQUAL "dumpbin" AND WT_ARCH STREQUAL "arm64")
				set(WT_ARCH_PATTERN "aa64 machine|machine \\(arm64\\)")
			elseif(WT_BINARY_INSPECTOR_KIND STREQUAL "dumpbin" AND WT_ARCH STREQUAL "x86")
				set(WT_ARCH_PATTERN "14c machine|machine \\(x86\\)")
			elseif(WT_ARCH STREQUAL "x64")
				set(WT_ARCH_PATTERN "x86[-_ ]64|amd64|i386:x86-64|pei-x86-64")
			elseif(WT_ARCH STREQUAL "arm64")
				set(WT_ARCH_PATTERN "aarch64|arm64")
			elseif(WT_ARCH STREQUAL "x86")
				set(WT_ARCH_PATTERN "80386|i[3-6]86|pei-i386")
			else()
				set(WT_BINARY_REASON "unsupported target architecture ${WT_ARCH}")
			endif()
			if(WT_ARCH_PATTERN AND WT_FILE_OUTPUT_LOWER MATCHES "${WT_ARCH_PATTERN}")
				set(WT_BINARY_OK TRUE)
			elseif(NOT WT_BINARY_REASON)
				set(WT_BINARY_REASON "reported '${WT_FILE_OUTPUT}', expected ${WT_ARCH}")
			endif()
		endif()
	endif()
	set(${WT_OUTPUT_OK} ${WT_BINARY_OK} PARENT_SCOPE)
	set(${WT_OUTPUT_REASON} "${WT_BINARY_REASON}" PARENT_SCOPE)
endfunction()

function(WT_SETUP_RUNTIME_VENDOR_DEPENDENCY)
	set(WT_VENDOR_ONE_VALUE_ARGS NAME PREFIX ENABLE ENABLE_OPTION ROOT OUT_BUILD)
	set(WT_VENDOR_MULTI_VALUE_ARGS HEADERS RUNTIME_BASENAMES LINK_BASENAMES)
	cmake_parse_arguments(WT_VENDOR "" "${WT_VENDOR_ONE_VALUE_ARGS}" "${WT_VENDOR_MULTI_VALUE_ARGS}" ${ARGN})
	foreach(WT_VENDOR_REQUIRED_ARG IN ITEMS NAME PREFIX ENABLE ROOT OUT_BUILD)
		if("${WT_VENDOR_${WT_VENDOR_REQUIRED_ARG}}" STREQUAL "")
			message(FATAL_ERROR "WT_SETUP_RUNTIME_VENDOR_DEPENDENCY requires ${WT_VENDOR_REQUIRED_ARG}")
		endif()
	endforeach()

	string(TOUPPER "${WT_VENDOR_ENABLE}" WT_VENDOR_ENABLE_VALUE)
	string(TOUPPER "${WT_VENDOR_NAME}" WT_VENDOR_NAME_UPPER)
	if(WT_VENDOR_ENABLE_OPTION)
		set(WT_VENDOR_ENABLE_OPTION "${WT_VENDOR_ENABLE_OPTION}")
	else()
		set(WT_VENDOR_ENABLE_OPTION "WT_ENABLE_${WT_VENDOR_NAME_UPPER}")
	endif()
	if(NOT WT_VENDOR_ENABLE_VALUE STREQUAL "AUTO" AND
		NOT WT_VENDOR_ENABLE_VALUE STREQUAL "ON" AND
		NOT WT_VENDOR_ENABLE_VALUE STREQUAL "OFF")
		message(FATAL_ERROR "${WT_VENDOR_ENABLE_OPTION} must be AUTO, ON, or OFF")
	endif()
	set(${WT_VENDOR_OUT_BUILD} OFF PARENT_SCOPE)
	if(WT_VENDOR_ENABLE_VALUE STREQUAL "OFF")
		message(STATUS "${WT_VENDOR_NAME} targets disabled")
		return()
	endif()

	set(WT_VENDOR_MISSING "")
	unset(WT_VENDOR_INCLUDE_DIR CACHE)
	find_path(WT_VENDOR_INCLUDE_DIR
		NAMES ${WT_VENDOR_HEADERS}
		PATHS "${WT_VENDOR_ROOT}" "${WT_VENDOR_ROOT}/include"
		NO_DEFAULT_PATH
	)
	foreach(WT_VENDOR_HEADER IN LISTS WT_VENDOR_HEADERS)
		if(NOT WT_VENDOR_INCLUDE_DIR OR NOT EXISTS "${WT_VENDOR_INCLUDE_DIR}/${WT_VENDOR_HEADER}")
			list(APPEND WT_VENDOR_MISSING "header ${WT_VENDOR_HEADER}")
		endif()
	endforeach()

	set(WT_VENDOR_RUNTIME_ARTIFACTS "")
	foreach(WT_VENDOR_RUNTIME_BASE IN LISTS WT_VENDOR_RUNTIME_BASENAMES)
		if(WT_SYSTEM STREQUAL "windows")
			set(WT_VENDOR_RUNTIME_NAMES "${WT_VENDOR_RUNTIME_BASE}.dll")
			set(WT_VENDOR_RUNTIME_DIRS "${WT_VENDOR_ROOT}/${WT_ARCH}" "${WT_VENDOR_ROOT}/bin/${WT_ARCH}" "${WT_VENDOR_ROOT}/bin" "${WT_VENDOR_ROOT}")
		elseif(WT_SYSTEM STREQUAL "macos")
			set(WT_VENDOR_RUNTIME_NAMES "lib${WT_VENDOR_RUNTIME_BASE}.dylib" "${WT_VENDOR_RUNTIME_BASE}.dylib")
			set(WT_VENDOR_RUNTIME_DIRS "${WT_VENDOR_ROOT}/macos/${WT_ARCH}" "${WT_VENDOR_ROOT}/${WT_ARCH}" "${WT_VENDOR_ROOT}/lib" "${WT_VENDOR_ROOT}")
		else()
			set(WT_VENDOR_RUNTIME_NAMES "lib${WT_VENDOR_RUNTIME_BASE}.so" "${WT_VENDOR_RUNTIME_BASE}.so")
			set(WT_VENDOR_RUNTIME_DIRS "${WT_VENDOR_ROOT}/linux/${WT_ARCH}" "${WT_VENDOR_ROOT}/linux/dll" "${WT_VENDOR_ROOT}/linux" "${WT_VENDOR_ROOT}/lib/${WT_ARCH}" "${WT_VENDOR_ROOT}/lib" "${WT_VENDOR_ROOT}")
		endif()
		set(WT_VENDOR_RUNTIME "")
		foreach(WT_VENDOR_RUNTIME_DIR IN LISTS WT_VENDOR_RUNTIME_DIRS)
			foreach(WT_VENDOR_RUNTIME_NAME IN LISTS WT_VENDOR_RUNTIME_NAMES)
				if(EXISTS "${WT_VENDOR_RUNTIME_DIR}/${WT_VENDOR_RUNTIME_NAME}")
					set(WT_VENDOR_RUNTIME "${WT_VENDOR_RUNTIME_DIR}/${WT_VENDOR_RUNTIME_NAME}")
					break()
				endif()
			endforeach()
			if(WT_VENDOR_RUNTIME)
				break()
			endif()
		endforeach()
		if(NOT WT_VENDOR_RUNTIME)
			list(APPEND WT_VENDOR_MISSING "runtime ${WT_VENDOR_RUNTIME_BASE}")
		else()
			WT_CHECK_VENDOR_BINARY_ARCH("${WT_VENDOR_RUNTIME}" WT_VENDOR_ARCH_OK WT_VENDOR_ARCH_REASON)
			if(NOT WT_VENDOR_ARCH_OK)
				list(APPEND WT_VENDOR_MISSING "runtime ${WT_VENDOR_RUNTIME_BASE} architecture (${WT_VENDOR_ARCH_REASON})")
			else()
				list(APPEND WT_VENDOR_RUNTIME_ARTIFACTS "${WT_VENDOR_RUNTIME}")
				string(MAKE_C_IDENTIFIER "${WT_VENDOR_RUNTIME_BASE}" WT_VENDOR_RUNTIME_KEY)
				set(WT_VENDOR_RUNTIME_${WT_VENDOR_RUNTIME_KEY} "${WT_VENDOR_RUNTIME}")
			endif()
		endif()
	endforeach()

	foreach(WT_VENDOR_LINK_BASE IN LISTS WT_VENDOR_LINK_BASENAMES)
		string(MAKE_C_IDENTIFIER "${WT_VENDOR_LINK_BASE}" WT_VENDOR_LINK_KEY)
		set(WT_VENDOR_LINK_RUNTIME "${WT_VENDOR_RUNTIME_${WT_VENDOR_LINK_KEY}}")
		if(WT_SYSTEM STREQUAL "windows")
			set(WT_VENDOR_IMPORT_DIRS
				"${WT_VENDOR_ROOT}/${WT_ARCH}"
				"${WT_VENDOR_ROOT}/lib/${WT_ARCH}"
				"${WT_VENDOR_ROOT}/lib"
				"${WT_VENDOR_ROOT}"
			)
			set(WT_VENDOR_IMPORT_VAR "WT_${WT_VENDOR_PREFIX}_${WT_VENDOR_LINK_KEY}_IMPORT_LIBRARY")
			unset(${WT_VENDOR_IMPORT_VAR} CACHE)
			find_library(${WT_VENDOR_IMPORT_VAR}
				NAMES "${WT_VENDOR_LINK_BASE}" "lib${WT_VENDOR_LINK_BASE}"
				PATHS ${WT_VENDOR_IMPORT_DIRS}
				NO_DEFAULT_PATH
			)
			set(WT_VENDOR_LINK_ARTIFACT "${${WT_VENDOR_IMPORT_VAR}}")
			if(NOT WT_VENDOR_LINK_ARTIFACT)
				list(APPEND WT_VENDOR_MISSING "import library ${WT_VENDOR_LINK_BASE}")
			endif()
		else()
			set(WT_VENDOR_LINK_ARTIFACT "${WT_VENDOR_LINK_RUNTIME}")
			if(NOT WT_VENDOR_LINK_ARTIFACT)
				list(APPEND WT_VENDOR_MISSING "link library ${WT_VENDOR_LINK_BASE}")
			endif()
		endif()
		set(WT_VENDOR_LINK_ARTIFACT_${WT_VENDOR_LINK_KEY} "${WT_VENDOR_LINK_ARTIFACT}")
	endforeach()

	if(WT_VENDOR_MISSING)
		list(REMOVE_DUPLICATES WT_VENDOR_MISSING)
		list(JOIN WT_VENDOR_MISSING ", " WT_VENDOR_MISSING_TEXT)
		if(WT_VENDOR_ENABLE_VALUE STREQUAL "ON")
			message(FATAL_ERROR "${WT_VENDOR_ENABLE_OPTION}=ON but ${WT_VENDOR_NAME} SDK is unusable: ${WT_VENDOR_MISSING_TEXT}. Root=${WT_VENDOR_ROOT}")
		endif()
		message(STATUS "Skipping ${WT_VENDOR_NAME} targets: ${WT_VENDOR_MISSING_TEXT}. Root=${WT_VENDOR_ROOT}")
		return()
	endif()

	set(WT_VENDOR_TARGET "WT_VENDOR_${WT_VENDOR_NAME}")
	set(WT_VENDOR_ALIAS "WT::Vendor::${WT_VENDOR_NAME}")
	if(TARGET ${WT_VENDOR_TARGET} OR TARGET ${WT_VENDOR_ALIAS})
		message(FATAL_ERROR "${WT_VENDOR_ALIAS} already exists")
	endif()
	add_library(${WT_VENDOR_TARGET} INTERFACE)
	add_library(${WT_VENDOR_ALIAS} ALIAS ${WT_VENDOR_TARGET})
	target_include_directories(${WT_VENDOR_TARGET} SYSTEM INTERFACE "${WT_VENDOR_INCLUDE_DIR}")
	foreach(WT_VENDOR_LINK_BASE IN LISTS WT_VENDOR_LINK_BASENAMES)
		string(MAKE_C_IDENTIFIER "${WT_VENDOR_LINK_BASE}" WT_VENDOR_LINK_KEY)
		set(WT_VENDOR_IMPORTED_TARGET "${WT_VENDOR_TARGET}_${WT_VENDOR_LINK_KEY}")
		if(WT_SYSTEM STREQUAL "windows")
			add_library(${WT_VENDOR_IMPORTED_TARGET} SHARED IMPORTED GLOBAL)
			set_target_properties(${WT_VENDOR_IMPORTED_TARGET} PROPERTIES
				IMPORTED_IMPLIB "${WT_VENDOR_LINK_ARTIFACT_${WT_VENDOR_LINK_KEY}}"
				IMPORTED_LOCATION "${WT_VENDOR_RUNTIME_${WT_VENDOR_LINK_KEY}}"
			)
		else()
			add_library(${WT_VENDOR_IMPORTED_TARGET} SHARED IMPORTED GLOBAL)
			set_target_properties(${WT_VENDOR_IMPORTED_TARGET} PROPERTIES
				IMPORTED_LOCATION "${WT_VENDOR_LINK_ARTIFACT_${WT_VENDOR_LINK_KEY}}"
			)
			if(WT_SYSTEM STREQUAL "linux")
				# Several bundled SDK libraries have no DT_SONAME.  Without this
				# property CMake passes their absolute SDK path to the linker and
				# that path is recorded in DT_NEEDED, defeating install RPATH.
				set_target_properties(${WT_VENDOR_IMPORTED_TARGET} PROPERTIES
					IMPORTED_NO_SONAME TRUE
				)
			endif()
		endif()
		target_link_libraries(${WT_VENDOR_TARGET} INTERFACE ${WT_VENDOR_IMPORTED_TARGET})
	endforeach()
	set_target_properties(${WT_VENDOR_TARGET} PROPERTIES WT_RUNTIME_ARTIFACTS "${WT_VENDOR_RUNTIME_ARTIFACTS}")
	set(${WT_VENDOR_PREFIX}_RUNTIME_ARTIFACTS "${WT_VENDOR_RUNTIME_ARTIFACTS}" PARENT_SCOPE)
	set(${WT_VENDOR_OUT_BUILD} ON PARENT_SCOPE)
	message(STATUS "${WT_VENDOR_NAME} targets enabled from ${WT_VENDOR_ROOT}")
endfunction()

function(WT_SETUP_HEADER_DEPENDENCIES)
	if(TARGET WT::fmt OR TARGET WT::RapidJSON)
		message(FATAL_ERROR "WT_SETUP_HEADER_DEPENDENCIES must be called exactly once")
	endif()

	add_library(WT_FMT INTERFACE)
	add_library(WT::fmt ALIAS WT_FMT)
	find_package(fmt CONFIG QUIET)
	if(TARGET fmt::fmt-header-only)
		target_link_libraries(WT_FMT INTERFACE fmt::fmt-header-only)
		target_compile_definitions(WT_FMT INTERFACE WT_USE_STANDALONE_FMT FMT_HEADER_ONLY)
		message(STATUS "Using fmt package target fmt::fmt-header-only")
	elseif(TARGET fmt::fmt)
		target_link_libraries(WT_FMT INTERFACE fmt::fmt)
		target_compile_definitions(WT_FMT INTERFACE WT_USE_STANDALONE_FMT)
		message(STATUS "Using fmt package target fmt::fmt")
	else()
		set(WT_FMT_SEARCH_PATHS ${WT_FMT_INCLUDE_PATHS})
		if(WT_DEPS_ROOT)
			list(PREPEND WT_FMT_SEARCH_PATHS "${WT_DEPS_ROOT}/include")
		endif()
		find_path(WT_FMT_INCLUDE_DIR NAMES fmt/format.h PATHS ${WT_FMT_SEARCH_PATHS})
		find_path(WT_SPDLOG_FMT_SHIM_INCLUDE_DIR NAMES spdlog/fmt/fmt.h PATHS ${WT_FMT_SEARCH_PATHS})
		if(WT_FMT_INCLUDE_DIR)
			target_include_directories(WT_FMT SYSTEM INTERFACE "${WT_FMT_INCLUDE_DIR}")
			target_compile_definitions(WT_FMT INTERFACE WT_USE_STANDALONE_FMT FMT_HEADER_ONLY)
			message(STATUS "Using standalone fmt headers at ${WT_FMT_INCLUDE_DIR}")
		elseif(WT_SPDLOG_FMT_SHIM_INCLUDE_DIR)
			target_include_directories(WT_FMT SYSTEM INTERFACE "${WT_SPDLOG_FMT_SHIM_INCLUDE_DIR}")
			target_compile_definitions(WT_FMT INTERFACE WT_USE_SPDLOG_FMT_SHIM FMT_HEADER_ONLY)
			message(STATUS "Using spdlog fmt shim headers at ${WT_SPDLOG_FMT_SHIM_INCLUDE_DIR}")
		else()
			message(FATAL_ERROR "Could not find fmt headers. Set WT_DEPS_ROOT, provide fmt_DIR/CMAKE_PREFIX_PATH, or install fmt/spdlog headers")
		endif()
	endif()

	add_library(WT_RAPIDJSON INTERFACE)
	add_library(WT::RapidJSON ALIAS WT_RAPIDJSON)
	find_package(RapidJSON CONFIG QUIET)
	if(TARGET RapidJSON::RapidJSON)
		target_link_libraries(WT_RAPIDJSON INTERFACE RapidJSON::RapidJSON)
		message(STATUS "Using RapidJSON package target RapidJSON::RapidJSON")
	else()
		set(WT_RAPIDJSON_SEARCH_PATHS ${WT_RAPIDJSON_INCLUDE_PATHS})
		if(WT_DEPS_ROOT)
			list(PREPEND WT_RAPIDJSON_SEARCH_PATHS "${WT_DEPS_ROOT}/include")
		endif()
		find_path(WT_RAPIDJSON_INCLUDE_DIR NAMES rapidjson/document.h PATHS ${WT_RAPIDJSON_SEARCH_PATHS})
		if(NOT WT_RAPIDJSON_INCLUDE_DIR)
			message(FATAL_ERROR "Could not find RapidJSON headers. Set WT_DEPS_ROOT, provide RapidJSON_DIR/CMAKE_PREFIX_PATH, or install RapidJSON")
		endif()
		target_include_directories(WT_RAPIDJSON SYSTEM INTERFACE "${WT_RAPIDJSON_INCLUDE_DIR}")
		message(STATUS "Using RapidJSON headers at ${WT_RAPIDJSON_INCLUDE_DIR}")
	endif()
endfunction()

function(WT_SETUP_BOOST_DEPENDENCY)
	if(TARGET WT::Boost)
		message(FATAL_ERROR "WT_SETUP_BOOST_DEPENDENCY must be called exactly once")
	endif()

	set(WT_BOOST_UPSTREAM_TARGETS
		Boost::filesystem
		Boost::thread
		Boost::chrono
		Boost::atomic
	)
	set(WT_BOOST_TARGETS_READY TRUE)
	foreach(WT_BOOST_UPSTREAM_TARGET IN LISTS WT_BOOST_UPSTREAM_TARGETS)
		if(NOT TARGET ${WT_BOOST_UPSTREAM_TARGET})
			set(WT_BOOST_TARGETS_READY FALSE)
		endif()
	endforeach()

	set(WT_BOOST_SELECTED_PREFIXES "")
	if(WT_DEPS_ROOT)
		set(WT_BOOST_SELECTED_PREFIXES "${WT_DEPS_ROOT}")
	elseif(CMAKE_PREFIX_PATH)
		set(WT_BOOST_SELECTED_PREFIXES ${CMAKE_PREFIX_PATH})
	elseif(WT_BOOST_PREFIX_HINTS)
		set(WT_BOOST_SELECTED_PREFIXES ${WT_BOOST_PREFIX_HINTS})
	endif()

	if(NOT WT_BOOST_TARGETS_READY)
		if(WT_BOOST_SELECTED_PREFIXES)
			find_package(Boost CONFIG QUIET COMPONENTS filesystem thread chrono atomic
				PATHS ${WT_BOOST_SELECTED_PREFIXES}
				NO_DEFAULT_PATH
			)
		else()
			find_package(Boost CONFIG QUIET COMPONENTS filesystem thread chrono atomic)
		endif()
	endif()

	set(WT_BOOST_TARGETS_READY TRUE)
	foreach(WT_BOOST_UPSTREAM_TARGET IN LISTS WT_BOOST_UPSTREAM_TARGETS)
		if(NOT TARGET ${WT_BOOST_UPSTREAM_TARGET})
			set(WT_BOOST_TARGETS_READY FALSE)
		endif()
	endforeach()
	if(NOT WT_BOOST_TARGETS_READY)
		set(Boost_NO_BOOST_CMAKE ON)
		set(Boost_NO_WARN_NEW_VERSIONS ON)
		if(WT_BOOST_SELECTED_PREFIXES)
			list(GET WT_BOOST_SELECTED_PREFIXES 0 WT_BOOST_FALLBACK_ROOT)
			set(Boost_ROOT "${WT_BOOST_FALLBACK_ROOT}")
			set(BOOST_ROOT "${WT_BOOST_FALLBACK_ROOT}")
			set(BOOST_INCLUDEDIR "${WT_BOOST_FALLBACK_ROOT}/include")
			if(IS_DIRECTORY "${WT_BOOST_FALLBACK_ROOT}/lib")
				set(BOOST_LIBRARYDIR "${WT_BOOST_FALLBACK_ROOT}/lib")
			elseif(IS_DIRECTORY "${WT_BOOST_FALLBACK_ROOT}/lib64")
				set(BOOST_LIBRARYDIR "${WT_BOOST_FALLBACK_ROOT}/lib64")
			endif()
		endif()
		find_package(Boost REQUIRED COMPONENTS filesystem thread chrono atomic)
	endif()

	if(TARGET Boost::headers)
		set(WT_BOOST_HEADERS_TARGET Boost::headers)
	elseif(TARGET Boost::boost)
		set(WT_BOOST_HEADERS_TARGET Boost::boost)
	else()
		message(FATAL_ERROR "Boost discovery did not provide Boost::headers or Boost::boost")
	endif()

	add_library(WT_BOOST INTERFACE)
	add_library(WT::Boost ALIAS WT_BOOST)
	target_link_libraries(WT_BOOST INTERFACE ${WT_BOOST_HEADERS_TARGET})

	foreach(WT_BOOST_COMPONENT IN ITEMS Filesystem Thread Chrono Atomic)
		string(TOUPPER "${WT_BOOST_COMPONENT}" WT_BOOST_COMPONENT_UPPER)
		string(TOLOWER "${WT_BOOST_COMPONENT}" WT_BOOST_COMPONENT_LOWER)
		add_library(WT_BOOST_${WT_BOOST_COMPONENT_UPPER} INTERFACE)
		add_library(WT::Boost${WT_BOOST_COMPONENT} ALIAS WT_BOOST_${WT_BOOST_COMPONENT_UPPER})
		target_link_libraries(WT_BOOST_${WT_BOOST_COMPONENT_UPPER} INTERFACE
			WT::Boost
			Boost::${WT_BOOST_COMPONENT_LOWER}
		)
	endforeach()
	message(STATUS "Using Boost ${Boost_VERSION_STRING} through target providers")
endfunction()

function(WT_SETUP_NANOMSG_DEPENDENCY)
	if(TARGET WT::Nanomsg)
		message(FATAL_ERROR "WT_SETUP_NANOMSG_DEPENDENCY must be called exactly once")
	endif()

	find_package(nanomsg CONFIG QUIET)
	if(TARGET nanomsg)
		set(WT_NANOMSG_TARGET nanomsg)
	elseif(TARGET nanomsg::nanomsg)
		set(WT_NANOMSG_TARGET nanomsg::nanomsg)
	elseif(TARGET Nanomsg::nanomsg)
		set(WT_NANOMSG_TARGET Nanomsg::nanomsg)
	endif()
	if(WT_NANOMSG_TARGET)
		add_library(WT_NANOMSG INTERFACE)
		add_library(WT::Nanomsg ALIAS WT_NANOMSG)
		target_link_libraries(WT_NANOMSG INTERFACE ${WT_NANOMSG_TARGET})
		message(STATUS "Using nanomsg package target ${WT_NANOMSG_TARGET}")
		return()
	endif()

	set(WT_NANOMSG_INCLUDE_HINTS ${WT_NANOMSG_INCLUDE_PATHS})
	set(WT_NANOMSG_LIBRARY_HINTS ${WT_NANOMSG_LIBRARY_PATHS})
	if(WT_DEPS_ROOT)
		list(PREPEND WT_NANOMSG_INCLUDE_HINTS "${WT_DEPS_ROOT}/include")
		list(PREPEND WT_NANOMSG_LIBRARY_HINTS "${WT_DEPS_ROOT}/lib" "${WT_DEPS_ROOT}/lib64")
	endif()
	find_path(WT_NANOMSG_INCLUDE_DIR NAMES nanomsg/nn.h HINTS ${WT_NANOMSG_INCLUDE_HINTS})
	find_library(WT_NANOMSG_LIB NAMES nanomsg HINTS ${WT_NANOMSG_LIBRARY_HINTS})
	if(NOT WT_NANOMSG_INCLUDE_DIR OR NOT WT_NANOMSG_LIB)
		message(FATAL_ERROR
			"Could not find nanomsg headers and library. Set WT_DEPS_ROOT, provide "
			"nanomsg_DIR/CMAKE_PREFIX_PATH, or install nanomsg"
		)
	endif()

	add_library(WT_NANOMSG_LIBRARY UNKNOWN IMPORTED)
	set_target_properties(WT_NANOMSG_LIBRARY PROPERTIES IMPORTED_LOCATION "${WT_NANOMSG_LIB}")
	add_library(WT_NANOMSG INTERFACE)
	add_library(WT::Nanomsg ALIAS WT_NANOMSG)
	target_include_directories(WT_NANOMSG SYSTEM INTERFACE "${WT_NANOMSG_INCLUDE_DIR}")
	target_link_libraries(WT_NANOMSG INTERFACE WT_NANOMSG_LIBRARY)
	message(STATUS "Using nanomsg library at ${WT_NANOMSG_LIB}")
	message(STATUS "Using nanomsg headers at ${WT_NANOMSG_INCLUDE_DIR}")
endfunction()

function(WT_SETUP_CTP_TARGETS)
	if(TARGET WT::CTP OR TARGET WT::CTP_MD OR TARGET WT::CTP_TRADER)
		message(FATAL_ERROR "WT_SETUP_CTP_TARGETS must be called exactly once")
	endif()
	if(NOT WT_CTP_HEADERS_FOUND OR NOT WT_CTP_INCLUDE_DIRS)
		message(FATAL_ERROR "WT_SETUP_CTP_TARGETS requires resolved CTP headers")
	endif()

	add_library(WT_CTP INTERFACE)
	add_library(WT::CTP ALIAS WT_CTP)
	target_include_directories(WT_CTP SYSTEM INTERFACE ${WT_CTP_INCLUDE_DIRS})

	if(WT_CTP_LIBRARIES_USABLE)
		add_library(WT_CTP_MD_LIBRARY UNKNOWN IMPORTED)
		set_target_properties(WT_CTP_MD_LIBRARY PROPERTIES
			IMPORTED_LOCATION "${WT_CTP_MD_LIBRARY_RESOLVED}"
		)
		add_library(WT_CTP_TRADER_LIBRARY UNKNOWN IMPORTED)
		set_target_properties(WT_CTP_TRADER_LIBRARY PROPERTIES
			IMPORTED_LOCATION "${WT_CTP_TRADER_LIBRARY_RESOLVED}"
		)

		add_library(WT_CTP_MD INTERFACE)
		add_library(WT::CTP_MD ALIAS WT_CTP_MD)
		target_link_libraries(WT_CTP_MD INTERFACE WT::CTP WT_CTP_MD_LIBRARY)
		target_compile_definitions(WT_CTP_MD INTERFACE WT_CTP_STATIC)

		add_library(WT_CTP_TRADER INTERFACE)
		add_library(WT::CTP_TRADER ALIAS WT_CTP_TRADER)
		target_link_libraries(WT_CTP_TRADER INTERFACE WT::CTP WT_CTP_TRADER_LIBRARY)
		target_compile_definitions(WT_CTP_TRADER INTERFACE WT_CTP_STATIC)
	endif()
endfunction()

function(WT_SETUP_ZMQ_DEPENDENCY)
	if(TARGET WT::ZMQ)
		message(FATAL_ERROR "WT_SETUP_ZMQ_DEPENDENCY must be called at most once")
	endif()

	find_package(cppzmq CONFIG QUIET)
	if(TARGET cppzmq)
		set(WT_CPPZMQ_TARGET cppzmq)
	elseif(TARGET cppzmq::cppzmq)
		set(WT_CPPZMQ_TARGET cppzmq::cppzmq)
	endif()
	if(WT_CPPZMQ_TARGET)
		add_library(WT_ZMQ INTERFACE)
		add_library(WT::ZMQ ALIAS WT_ZMQ)
		target_link_libraries(WT_ZMQ INTERFACE ${WT_CPPZMQ_TARGET})
		set(WT_ZMQ_MISSING "" PARENT_SCOPE)
		message(STATUS "Using cppzmq package target ${WT_CPPZMQ_TARGET}")
		return()
	endif()

	set(WT_ZMQ_INCLUDE_HINTS ${WT_ZMQ_INCLUDE_PATHS})
	set(WT_CPPZMQ_INCLUDE_HINTS ${WT_CPPZMQ_INCLUDE_PATHS})
	set(WT_ZMQ_LIBRARY_HINTS ${WT_ZMQ_LIBRARY_PATHS})
	if(WT_DEPS_ROOT)
		list(PREPEND WT_ZMQ_INCLUDE_HINTS "${WT_DEPS_ROOT}/include")
		list(PREPEND WT_CPPZMQ_INCLUDE_HINTS "${WT_DEPS_ROOT}/include")
		list(PREPEND WT_ZMQ_LIBRARY_HINTS "${WT_DEPS_ROOT}/lib" "${WT_DEPS_ROOT}/lib64")
	endif()

	find_path(WT_ZMQ_INCLUDE_DIR NAMES zmq.h HINTS ${WT_ZMQ_INCLUDE_HINTS})
	find_path(WT_CPPZMQ_INCLUDE_DIR NAMES zmq.hpp HINTS ${WT_CPPZMQ_INCLUDE_HINTS})
	find_library(WT_ZMQ_LIB NAMES zmq libzmq HINTS ${WT_ZMQ_LIBRARY_HINTS})

	set(WT_ZMQ_MISSING "")
	if(NOT WT_ZMQ_INCLUDE_DIR)
		list(APPEND WT_ZMQ_MISSING "zmq.h")
	endif()
	if(NOT WT_CPPZMQ_INCLUDE_DIR)
		list(APPEND WT_ZMQ_MISSING "zmq.hpp/cppzmq")
	endif()
	if(NOT WT_ZMQ_LIB)
		list(APPEND WT_ZMQ_MISSING "libzmq")
	endif()
	if(WT_ZMQ_MISSING)
		set(WT_ZMQ_MISSING "${WT_ZMQ_MISSING}" PARENT_SCOPE)
		return()
	endif()

	add_library(WT_ZMQ_LIBRARY UNKNOWN IMPORTED)
	set_target_properties(WT_ZMQ_LIBRARY PROPERTIES IMPORTED_LOCATION "${WT_ZMQ_LIB}")
	add_library(WT_ZMQ INTERFACE)
	add_library(WT::ZMQ ALIAS WT_ZMQ)
	target_include_directories(WT_ZMQ SYSTEM INTERFACE
		"${WT_ZMQ_INCLUDE_DIR}"
		"${WT_CPPZMQ_INCLUDE_DIR}"
	)
	target_link_libraries(WT_ZMQ INTERFACE WT_ZMQ_LIBRARY)
	set(WT_ZMQ_MISSING "" PARENT_SCOPE)
	message(STATUS "Using ZeroMQ library at ${WT_ZMQ_LIB}")
	message(STATUS "Using ZeroMQ headers at ${WT_ZMQ_INCLUDE_DIR} and ${WT_CPPZMQ_INCLUDE_DIR}")
endfunction()
